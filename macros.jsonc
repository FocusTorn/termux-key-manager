{
    "definitions": {

        "?": {
            "display": "?",
            "macro": "CTRL b n"
        },

        "CTRL": {
            "key": "CTRL"
        },

        "TAB": {
            "display": "⮕Ⅰ",
            "key": "TAB",
            "popup": {
                "display": "⤺",
                "macro": "\u001F"
            }
        },

        "SHFT": {
            "display": "SHFT",
            "key": "SHIFT"
        },

        "ALT": {
            "key": "ALT"
        },

        "UDO": {
            "display": "⤺",
            "macro": "\u001F"
        },

        "UP": {
            "key": "UP",
            "popup": "PGUP"
        },

        "DN": {
            "key": "DOWN",
            "popup": "PGDN"
        },

        "LT": {
            "key": "LEFT",
            "popup": "HOME"
        },

        "RT": {
            "key": "RIGHT",
            "popup": "END"
        },

        "CLR": {
            "actions": [
                { "tmux": "copy_mode_exit" },
                { "shell": "clr" }
            ],
            "display": "❌",
            "popup": {
                "display": "♻ ↺",
                "shell": "refresh"
            }
        },

        "CPY_TEST": {
            "display": "🧪",
            "actions": [
                { "tmux": "copy_test_result" }
            ]
        },

        "CPY_PASTE": {
            "display": "🗨",
            "actions": [
                { "shell": "PASTE ENTER" },
                { "shell": "cpy_all" }
            ]
        },

        "CPY_ALL": {
            "display": "📄",
            "actions": [
                { "tmux": "copy_entire_pane" }
            ],
            "popup": {
                "display": "COPY",
                "actions": [
                    { "tmux": "copy_mode_exit" },
                    { "shell": "cpy" }
                ]
            }
        },
        "PST": {
            "display": "⧉",
            "macro": "PASTE ENTER",
            "popup": {
                "key": "PASTE"
            }
        },

        " ": {
            "display": " ",
            "macro": "",

            "holder": "⌫ ⧉ ⎌ ⎋ 📤  📥 📲 🗨 🛑 ⧠ ⧉ 📄 📃 📑 📷 📜 📋 ⚼ ❐ 🗃 📋 ⟏ ⍉ 🔳  ⍉ 📝  🚫 💥 🧾 ❌ 🛇 💢"
        }

    },
    "layout": [
        [ "SHFT", "TAB", " ", " "      , "PST"     , "CLR"      , " ", " "  , "UP", " "  ],
        [ "CTRL", "ALT", " ", "CPY_ALL", "CPY_TEST", "CPY_PASTE", " ", "LT" , "DN", "RT" ]
    ]
}
