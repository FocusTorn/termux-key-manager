{
    "definitions": {

        "?": {
            "display": "?",
            "macro": "CTRL b n"
        },






        "CTRL": {
            "key": "CTRL"
        },

        "TAB": {
            "display": "⮕Ⅰ",
            "key": "TAB"
        },

        "SHFT": {
            "display": "SHFT",
            "key": "SHIFT"
        },

        "ALT": {
            "key": "ALT"
        },

        "UDO": {
            "display": "⤺",
            "macro": "\u001F"
        },

        "UP": {
            "key": "UP",
            "popup": "PGUP"
        },

        "DN": {
            "key": "DOWN",
            "popup": "PGDN"
        },

        "LT": {
            "key": "LEFT",
            "popup": "HOME"
        },

        "RT": {
            "key": "RIGHT",
            "popup": "END"
        },

        "CLR": {
            "actions": [
                { "tmux": "cancel-copy-mode" },
                { "shell": "clr" }
            ],
            "display": "⌫",

            "popup": {
                "display": "♻ ↺",
                "shell": "refresh"
            }
        },

        "CPY_ALL": {
            "display": "📑",
            "actions": [
                { "tmux": "cancel-copy-mode" },
                { "shell": "cpy_all" }
            ],

            "popup": {
                "display": "COPY",
                "actions": [
                    { "tmux": "cancel-copy-mode" },
                    { "shell": "cpy" }
                ]
            }
        },

        "PST": {
            "macro": "PASTE ENTER",

            "popup": {
                "key": "PASTE"
            },


            "holder": "⎌ ⎋  🛑 ⧠ ⧉ 📋 ⚼ ❐ 🗃 📋 ⟏ ⍉ 🔳  ⍉ 📝  🚫 💥 🧾 ❌ 🛇 💢"
        },

        " ": {
            "display": " ",
            "macro": ""
        }

    },

    "layout": [
        [ "SHFT", "UDO", "CPY_ALL" , "CLR", " ", " "  , "UP", " "  ],
        [ "CTRL", "ALT", "TAB"     , "PST", " ", "LT" , "DN", "RT" ]
    ]
}
