#!/usr/bin/env bash
# Thin adapter for the shared test-runner.
# Do NOT add argument parsing, path validation, or mode handling here;
# test-runner owns all of that. Forward "$@" unchanged.
# Only edit the project setting below.
set -o errexit
set -o nounset
set -o pipefail

readonly suite_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly project_root="$(dirname -- "$suite_directory")"

# Project setting: Python source dir, relative to the project root
# (or absolute). Empty means none.
readonly source_dir='.'

runner_args=(--working-dir "$project_root")
[[ -z "$source_dir" ]] || runner_args+=(--source-dir "$source_dir")

exec "${TEST_RUNNER:-$HOME/bin/test-runner}" "${runner_args[@]}" "$suite_directory" "$@"
