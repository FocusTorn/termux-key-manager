export HISTIGNORE='__TKM_HISTIGNORE__'


edit_create() {

    __EDIT_TARGET="$1"
    __EDIT_SPEC="$(cat; printf '')"
    __EDIT_SPEC="${__EDIT_SPEC%$''}"
}


edit_execute() {

    EDIT_TARGET="$__EDIT_TARGET" EDIT_SPEC="$__EDIT_SPEC" python - <<'PY_EDIT'
import difflib
import os
import sys
from pathlib import Path

target = Path(os.environ["EDIT_TARGET"])
spec = os.environ["EDIT_SPEC"]

lines = spec.splitlines(keepends=True)

try:
    old_marker = lines.index("--- old\n")
    new_marker = lines.index("--- new\n")
except ValueError:
    print("FAIL: edit specification requires --- old and --- new", file=sys.stderr)
    raise SystemExit(1)

if old_marker != 0:
    print("FAIL: edit specification must begin with --- old", file=sys.stderr)
    raise SystemExit(1)

old = "".join(lines[old_marker + 1:new_marker])
new = "".join(lines[new_marker + 1:])

if not old:
    print("FAIL: old text is empty", file=sys.stderr)
    raise SystemExit(1)

text = target.read_text()

count = text.count(old)

if count == 1:
    result = text.replace(old, new, 1)
    target.write_text(result)
    print(f"PASS: edited {target}")
    raise SystemExit(0)

if count > 1:
    print(f"FAIL: exact text occurs {count} times in {target}", file=sys.stderr)
    raise SystemExit(1)

print(f"FAIL: exact text not found in {target}", file=sys.stderr)

old_lines = old.splitlines()
target_lines = text.splitlines()

best = []

for size in range(max(1, len(old_lines) - 2), len(old_lines) + 3):
    if size > len(target_lines):
        continue

    for start in range(len(target_lines) - size + 1):
        candidate = target_lines[start:start + size]
        candidate_text = "\n".join(candidate)
        old_text = "\n".join(old_lines)
        ratio = difflib.SequenceMatcher(None, old_text, candidate_text).ratio()
        best.append((ratio, start + 1, candidate))

for ratio, start, candidate in sorted(best, reverse=True)[:3]:
    print(
        f"  possible match at line {start} ({ratio:.0%})",
        file=sys.stderr,
    )
    for line in candidate:
        print(f"    {line}", file=sys.stderr)

raise SystemExit(1)
PY_EDIT
}


refresh() {
    "$HOME/.termux/tkm-refresh"
}


clr() {

    if [ -n "$TMUX" ]; then
        tmux send-keys -t "$TMUX_PANE" C-c
        tmux send-keys -t "$TMUX_PANE" -R
        tmux clear-history
    else
        printf '\003'
        printf '\033c'
        clear
    fi
}




