#!/data/data/com.termux/files/usr/bin/bash

refresh_status() {
    printf '\033[2;32m✓\033[0m \033[90m%s\033[0m\n' "${1#✓ }"
}

refresh_success() {
    printf '✅ \033[1;97m%s\033[0m\n' "${1#✅ }"
}

printf '\n'

if [ -n "$TMUX" ]; then
    if python "$HOME/projects/termux-key-manager/update.py"; then
        source ~/.bashrc &&
        refresh_status '✓ ~/.bashrc sourced' &&
        tmux source-file ~/.tmux.conf &&
        refresh_status '✓ ~/.tmux.conf sourced' &&
        refresh_success '✅ Termux configuration updated' &&
        printf '\n'
    fi
    exit
fi

if tmux list-sessions >/dev/null 2>&1; then
    tmux kill-server
fi

if python "$HOME/projects/termux-key-manager/update.py"; then
    refresh_status '✓ ~/.bashrc loaded' &&
    refresh_status '✓ ~/.tmux.conf loaded' &&
    refresh_success '✅ Termux configuration updated' &&
    printf '\n' &&
    exec tmux new-session -c "$HOME"
fi
